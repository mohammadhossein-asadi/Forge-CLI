{
  "name": "@forge/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core engine for Forge CLI — DI container, kernel, bootstrap, commands, config, events, hooks, plugins, logging, errors, filesystem",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@forge/shared": "workspace:*",
    "zod": "^3.24.0",
    "cosmiconfig": "^9.0.0",
    "fast-glob": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
